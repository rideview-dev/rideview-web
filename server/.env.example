# Copy this file to ".env" and fill in your values.
# Never commit the real .env to version control.

# ---- Server ----
# Port the server listens on (default 8000)
PORT=8000

# Comma-separated allowed origins for CORS, or * for any.
# In production set this to your real domain, e.g. https://rideview.ca
# (Irrelevant when SERVE_SITE=true, since the site and API then share one origin.)
ALLOWED_ORIGINS=https://rideview.ca,https://www.rideview.ca

# Serve the marketing site from this same Node process (default true), so the
# front-end and the API share one origin. Set to false to run API-only behind a
# separate static host — in that case main.js must be given this server's HTTPS
# origin, or the form will have nowhere to post to.
SERVE_SITE=true

# How many reverse proxies sit in front of this server. Leave blank when the
# process is exposed directly. Set to 1 behind a single proxy/CDN/PaaS router
# (Render, Railway, Fly, nginx), or to a comma-separated list of trusted proxy
# IPs/CIDRs. Too trusting lets clients spoof their IP; not trusting enough
# collapses every visitor into one shared rate-limit bucket.
TRUST_PROXY=

# Accepted submissions allowed per client IP per 10 minutes (default 10).
# Rejected submissions and honeypot hits do NOT count toward this.
RATE_LIMIT_MAX=10

# Folder for the SAFETY-NET fallback file only (used if the DB is unreachable).
# Default is ./data next to server.js.
DATA_DIR=

# Optional token to protect the GET /api/submissions endpoint, which returns
# stored leads as JSON. Leave blank to DISABLE that endpoint entirely.
# When set, call it with header  Authorization: Bearer <token>  (or ?token=<token>).
ADMIN_TOKEN=

# ---- PostgreSQL ----
# Easiest: one connection string (works with Render, Railway, Supabase, Neon, Heroku, etc.)
#   postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# ...OR set these discrete variables instead of DATABASE_URL (node-postgres reads them automatically):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=rideview
# PGPASSWORD=
# PGDATABASE=rideview

# Set to "require" if your Postgres host needs SSL (most managed/cloud DBs do).
# Leave blank for a local database.
PGSSL=

# ---- Email notifications (SMTP via Nodemailer) ----
# Leave SMTP_HOST or MAIL_TO blank to turn email OFF (leads still save to the DB).
# This is plain SMTP, so it works with your mail host, Gmail/Outlook, or a
# transactional provider (Resend, SendGrid, Mailgun) — just paste their SMTP creds.
# Configured for Resend. SMTP_USER is the literal string "resend"; SMTP_PASS is
# the API key from the Resend dashboard (it starts with "re_").
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=

# Who the internal "new lead" notification goes to (comma-separated for several).
MAIL_TO=sales@rideview.ca

# Envelope sender for BOTH emails (the team notification and the visitor's
# confirmation).
MAIL_FROM=dev@rideview.ca

# Where a reply to the visitor's confirmation email should land. Defaults to
# MAIL_TO. Point it at whoever actually works the leads.
MAIL_REPLY_TO=sales@rideview.ca

# Send the visitor a "thanks, we'll be in touch" confirmation in the language
# they were reading the site in (en/fr/es/ru/ar). Set to false to send only the
# internal notification.
SEND_CONFIRMATION=true

# --- Provider quick reference (SMTP_HOST / SMTP_PORT) ---
# Gmail:    smtp.gmail.com / 587   (SMTP_USER = full address, SMTP_PASS = an App Password)
# Outlook:  smtp.office365.com / 587
# SendGrid: smtp.sendgrid.net / 587 (SMTP_USER = "apikey", SMTP_PASS = your API key)
# Resend:   smtp.resend.com / 587   (SMTP_USER = "resend", SMTP_PASS = your API key)
# Mailgun:  smtp.mailgun.org / 587
