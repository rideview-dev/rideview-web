# Copy this file to ".env" and fill in your values.
# Never commit the real .env to version control.

# ---- Server ----
# Port the server listens on (default 8000)
PORT=8000

# Comma-separated allowed origins for CORS, or * for any.
# In production set this to your real domain, e.g. https://rideview.ca
ALLOWED_ORIGINS=*

# Folder for the SAFETY-NET fallback file only (used if the DB is unreachable).
# Default is ./data next to server.js.
DATA_DIR=

# Optional token to protect the GET /api/submissions endpoint, which returns
# stored leads as JSON. Leave blank to DISABLE that endpoint entirely.
# When set, call it with header  Authorization: Bearer <token>  (or ?token=<token>).
ADMIN_TOKEN=

# ---- PostgreSQL ----
# Easiest: one connection string (works with Render, Railway, Supabase, Neon, Heroku, etc.)
#   postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# ...OR set these discrete variables instead of DATABASE_URL (node-postgres reads them automatically):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=rideview
# PGPASSWORD=
# PGDATABASE=rideview

# Set to "require" if your Postgres host needs SSL (most managed/cloud DBs do).
# Leave blank for a local database.
PGSSL=

# ---- Email notifications (SMTP via Nodemailer) ----
# Leave SMTP_HOST or MAIL_TO blank to turn email OFF (leads still save to the DB).
# This is plain SMTP, so it works with your mail host, Gmail/Outlook, or a
# transactional provider (Resend, SendGrid, Mailgun) — just paste their SMTP creds.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Where lead notifications are sent (comma-separated for multiple recipients)
# and who they appear to be from.
MAIL_TO=partners@rideview.ca
MAIL_FROM=

# --- Provider quick reference (SMTP_HOST / SMTP_PORT) ---
# Gmail:    smtp.gmail.com / 587   (SMTP_USER = full address, SMTP_PASS = an App Password)
# Outlook:  smtp.office365.com / 587
# SendGrid: smtp.sendgrid.net / 587 (SMTP_USER = "apikey", SMTP_PASS = your API key)
# Resend:   smtp.resend.com / 587   (SMTP_USER = "resend", SMTP_PASS = your API key)
# Mailgun:  smtp.mailgun.org / 587
